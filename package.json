{
  "name": "tiddlywiki-cloudflare",
  "private": true,
  "type": "module",
  "version": "2026.10.27",
  "license": "MIT",
  "author": "Théophile Desmedt (https://github.com/DesignThinkerer)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesignThinkerer/tiddlywiki-cloudflare.git"
  },
  "homepage": "https://github.com/DesignThinkerer/tiddlywiki-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/DesignThinkerer/tiddlywiki-cloudflare/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Host your own TiddlyWiki on Cloudflare's free plan: a worker for editing, R2 for storage, a public site served from the cache, and every save backed up to GitHub",
  "scripts": {
    "build": "node build.mjs && node tools/build-wiki.mjs",
    "check:build": "node build.mjs --check",
    "screenshot": "npm run build && node tools/screenshot.mjs",
    "lint": "eslint src build.mjs tools test eslint.config.js",
    "test": "npm run build && node tools/run-suites.mjs two-tabs page-publish queue-backup lazy-load budget cold-start plugins offline integrity bake private login-expired setup-check backup-sync r2-ops first-visit cpu repository",
    "test:fast": "npm run build && node tools/run-suites.mjs queue-backup integrity bake setup-check r2-ops cpu repository",
    "test:browser": "npm run build && node tools/run-suites.mjs two-tabs page-publish lazy-load budget cold-start plugins offline private login-expired backup-sync first-visit",
    "test:suite": "npm run build && node tools/run-suites.mjs",
    "test:bake": "npm run build && node test/bake.test.mjs",
    "test:first": "npm run build && node test/first-visit.test.mjs",
    "test:integrity": "npm run build && node test/integrity.test.mjs",
    "test:repository": "npm run build && node test/repository.test.mjs",
    "test:r2": "npm run build && node test/r2-ops.test.mjs",
    "test:cpu": "npm run build && node test/cpu.test.mjs",
    "test:backup": "npm run build && node test/queue-backup.test.mjs",
    "test:tabs": "npm run build && node test/two-tabs.test.mjs",
    "test:plugins": "npm run build && node test/plugins.test.mjs",
    "test:publish": "npm run build && node test/page-publish.test.mjs",
    "test:lazy": "npm run build && node test/lazy-load.test.mjs",
    "test:sync": "npm run build && node test/backup-sync.test.mjs",
    "test:private": "npm run build && node test/private.test.mjs",
    "test:offline": "npm run build && node test/offline.test.mjs",
    "test:login": "npm run build && node test/login-expired.test.mjs",
    "test:cold": "npm run build && node test/cold-start.test.mjs",
    "test:budget": "npm run build && node test/budget.test.mjs",
    "test:setup": "npm run build && node test/setup-check.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "miniflare": "4.20260730.0",
    "playwright": "1.64.1",
    "tiddlywiki": "5.4.1",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  }
}
